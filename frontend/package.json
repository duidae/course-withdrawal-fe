{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "prepare": "cd .. && husky frontend/.husky",
    "lint": "eslint .",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,html,md}\""
  },
  "dependencies": {
    "@emotion/styled": "~11.14.1",
    "@mui/icons-material": "~9.2.0",
    "@mui/material": "~9.2.0",
    "@mui/x-date-pickers": "~9.12.0",
    "dayjs": "~1.11.23",
    "axios": "~1.16.0",
    "dompurify": "~3.4.2",
    "highlight.js": "~11.11.1",
    "katex": "~0.16.45",
    "notistack": "~3.0.2",
    "quill": "~2.0.3",
    "quill-delta": "~5.1.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-dropzone": "~15.0.0",
    "react-error-boundary": "~6.1.1",
    "react-intl": "~10.1.5",
    "react-router-dom": "~7.15.0",
    "sass": "~1.99.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "~9.1.7",
    "lint-staged": "~12.5.0",
    "prettier": "~3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,md}": "prettier --write --ignore-unknown"
  }
}
